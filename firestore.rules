rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserWorkspaceProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'provider', 'workspaceRole', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'provider', 'workspaceRole', 'photoUrl', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && data.provider in ['google', 'password']
        && data.workspaceRole in ['teacher', 'student']
        && (!data.keys().hasAny(['photoUrl']) || (data.photoUrl is string && data.photoUrl.size() <= 1000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'providerId', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'providerId', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.providerId is string
        && data.providerId.size() >= 1
        && data.providerId.size() <= 64
        && (!data.keys().hasAny(['email']) || (data.email is string && data.email.size() <= 254))
        && data.updatedAt is timestamp;
    }

    function isValidAttemptRecord(data, userId, attemptId) {
      return data.keys().hasAll([
          'id',
          'ownerId',
          'questionnaireId',
          'questionnaireTitle',
          'bookTitle',
          'score',
          'totalPoints',
          'percentage',
          'timeSpentSeconds',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'id',
          'ownerId',
          'questionnaireId',
          'questionnaireTitle',
          'bookTitle',
          'score',
          'totalPoints',
          'percentage',
          'timeSpentSeconds',
          'createdAt'
        ])
        && isValidId(data.id)
        && data.id == attemptId
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.questionnaireId is string
        && data.questionnaireId.size() >= 1
        && data.questionnaireId.size() <= 128
        && data.questionnaireTitle is string
        && data.questionnaireTitle.size() >= 1
        && data.questionnaireTitle.size() <= 250
        && data.bookTitle is string
        && data.bookTitle.size() >= 1
        && data.bookTitle.size() <= 250
        && data.score is number
        && data.score >= 0
        && data.totalPoints is number
        && data.totalPoints >= 0
        && data.percentage is number
        && data.percentage >= 0
        && data.percentage <= 100
        && data.timeSpentSeconds is number
        && data.timeSpentSeconds >= 0
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserWorkspaceProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserWorkspaceProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'workspaceRole', 'photoUrl', 'updatedAt']);
      allow delete: if isValidId(userId) && isOwner(userId);

      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && docId == 'info' && isOwner(userId);
        allow list: if false;
        allow create: if isValidId(userId)
          && isValidId(docId)
          && docId == 'info'
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(docId)
          && docId == 'info'
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'providerId', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(docId) && docId == 'info' && isOwner(userId);
      }

      match /attempts/{attemptId} {
        allow get: if isValidId(userId) && isValidId(attemptId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(attemptId)
          && isOwner(userId)
          && isValidAttemptRecord(incoming(), userId, attemptId)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(attemptId) && isOwner(userId);
      }
    }
  }
}
